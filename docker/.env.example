# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=False
# By default, allowed hosts is *. Uncomment and set the desired values if you want to make it more restrictive
#ALLOWED_HOSTS=*
# Add your external URL if behind a reverse proxyto prevent CSRF errors
#CSRF_TRUSTED_ORIGINS=https://my.domain.com/
LANGUAGE_CODE=en
# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL) - default is WARNING
#LOG_LEVEL=WARNING

# Set to True when serving over HTTPS
COOKIE_SECURE=True

# MariaDB
DB_ENGINE=mariadb
DB_NAME=storyteller
DB_USER=storyteller
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
MARIADB_ROOT_PASSWORD=change-me-root

# Redis
REDIS_URL=redis://redis:6379/0

# HocusPocus (collaborative editing)
HOCUSPOCUS_AUTH_URL=http://backend:8000/api/internal/yjs-auth/
HOCUSPOCUS_SECRET=change-me-to-a-random-string

